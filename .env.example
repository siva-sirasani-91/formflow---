# GEMINI_API_KEY: Optional server-side Gemini API key (never prefix with VITE_).
GEMINI_API_KEY=

# APP_URL: Public URL where the application is hosted.
APP_URL=http://localhost:3000

# SPRING_BACKEND_URL: Target Spring Boot REST API URL used by the Vite dev proxy and Express server.
SPRING_BACKEND_URL=http://localhost:8080

# VITE_API_BASE_URL: Leave empty to route /api/* through the Vite dev proxy (recommended),
# or set to http://localhost:8080 when calling Spring Boot directly.
VITE_API_BASE_URL=

# ---------------- Spring Boot + MySQL Environment Variables ----------------
# Provide real values in your local environment or cloud secret manager (never commit secrets).
# Local MySQL example:
#   DB_URL=jdbc:mysql://localhost:3306/formflow_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# Managed cloud MySQL (e.g., Enzonic) with TLS/SSL example:
#   DB_URL=jdbc:mysql://<host>:<port>/<database>?sslMode=REQUIRED&serverTimezone=UTC
SERVER_PORT=8080
DB_URL=
DB_USERNAME=
DB_PASSWORD=
JWT_SECRET=
JPA_DDL_AUTO=update
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
